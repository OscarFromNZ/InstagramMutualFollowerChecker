<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Crimson+Pro:ital,wght@0,400;0,600;1,400&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="styles.css">
</head>
<body>

  <div id="app">
    <header>
      <div class="aperture" aria-hidden="true">
        <svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor">
          <circle cx="40" cy="40" r="36" stroke-width="0.75" opacity="0.4"/>
          <circle cx="40" cy="40" r="24" stroke-width="1.25"/>
          <circle cx="40" cy="40" r="10" stroke-width="0.75" opacity="0.6"/>
          <line x1="40" y1="4"  x2="40" y2="76" stroke-width="0.5" opacity="0.2"/>
          <line x1="4"  y1="40" x2="76" y2="40" stroke-width="0.5" opacity="0.2"/>
          <line x1="12" y1="12" x2="68" y2="68" stroke-width="0.5" opacity="0.2"/>
          <line x1="68" y1="12" x2="12" y2="68" stroke-width="0.5" opacity="0.2"/>
          <circle cx="40" cy="16" r="2.5" fill="currentColor" stroke="none"/>
          <circle cx="62" cy="29" r="2.5" fill="currentColor" stroke="none"/>
          <circle cx="62" cy="51" r="2.5" fill="currentColor" stroke="none"/>
          <circle cx="40" cy="64" r="2.5" fill="currentColor" stroke="none"/>
          <circle cx="18" cy="51" r="2.5" fill="currentColor" stroke="none"/>
          <circle cx="18" cy="29" r="2.5" fill="currentColor" stroke="none"/>
        </svg>
      </div>
      <h1>Mutual<br>Followers</h1>
      <p class="tagline">Map the overlap between any Instagram audiences</p>
    </header>

    <main class="container">

      <!-- SEARCH -->
      <section class="search-section">
        <div class="section-label">TARGET PROFILES</div>
        <div class="input-group">
          <div id="usernames-container">
            <div class="input-row">
              <span class="input-num">01</span>
              <input type="text" class="username-input" placeholder="username"
                     autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"/>
            </div>
            <div class="input-row">
              <span class="input-num">02</span>
              <input type="text" class="username-input" placeholder="username"
                     autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"/>
            </div>
          </div>
          <div class="btn-row">
            <button id="add-username-btn" class="btn btn-ghost">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <line x1="6" y1="1" x2="6" y2="11" stroke="currentColor" stroke-width="1.5"/>
                <line x1="1" y1="6" x2="11" y2="6" stroke="currentColor" stroke-width="1.5"/>
              </svg>
              Add Profile
            </button>
            <button id="search-btn" class="btn btn-primary">
              Run Scan &nbsp;→
            </button>
          </div>
        </div>
      </section>

      <!-- RESULTS -->
      <section id="results-section" class="results-section" style="display: none;">
        <div class="results-header">
          <div>
            <div class="section-label">SCAN COMPLETE</div>
            <h2 class="results-title">Intelligence Report</h2>
          </div>
          <button id="clear-btn" class="btn btn-ghost">New Scan</button>
        </div>

        <div class="stats">
          <div class="stat-box">
            <span class="stat-label">Profiles Scanned</span>
            <span id="accounts-count" class="stat-value">0</span>
          </div>
          <div class="stat-box stat-accent">
            <span class="stat-label">Mutual Followers</span>
            <span id="mutual-count" class="stat-value">0</span>
          </div>
        </div>

        <div id="followers-list" class="followers-list"></div>
      </section>

      <!-- LOADING -->
      <section id="loading-section" class="loading-section" style="display: none;">
        <div class="loader-ring" aria-hidden="true">
          <div class="loader-inner"></div>
        </div>
        <p class="loading-text">Scanning profiles<span class="blink-dots"></span></p>
        <p class="loading-sub">This may take a moment for large accounts</p>
      </section>

      <!-- ERROR -->
      <section id="error-section" class="error-section" style="display: none;">
        <div class="error-head">
          <span class="error-flag" aria-hidden="true">!</span>
          <div>
            <h3>Scan Failed</h3>
            <p id="error-message">An unexpected error occurred.</p>
          </div>
        </div>
        <div class="error-tips">
          <p class="section-label">TROUBLESHOOTING</p>
          <ul>
            <li>Verify usernames are spelled correctly</li>
            <li>Accounts must be public — private accounts cannot be scanned</li>
            <li>Instagram may be rate-limiting — wait a minute and retry</li>
            <li>Your session ID may have expired; update <code>INSTAGRAM_SESSION_ID</code> in <code>.env</code></li>
          </ul>
        </div>
      </section>

    </main>
  </div>

  <script>
    const usernamesContainer = document.getElementById('usernames-container');
    const addUsernameBtn     = document.getElementById('add-username-btn');
    const searchBtn          = document.getElementById('search-btn');
    const clearBtn           = document.getElementById('clear-btn');
    const loadingSection     = document.getElementById('loading-section');
    const resultsSection     = document.getElementById('results-section');
    const errorSection       = document.getElementById('error-section');
    const followersList      = document.getElementById('followers-list');

    let inputCount = 2;

    addUsernameBtn.addEventListener('click', () => {
      inputCount++;
      const row = document.createElement('div');
      row.className = 'input-row';
      row.innerHTML = `
        <span class="input-num">${String(inputCount).padStart(2,'0')}</span>
        <input type="text" class="username-input" placeholder="username"
               autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"/>
      `;
      usernamesContainer.appendChild(row);
      row.querySelector('input').focus();
    });

    searchBtn.addEventListener('click', async () => {
      const usernames = Array.from(document.querySelectorAll('.username-input'))
        .map(i => i.value.trim())
        .filter(v => v.length > 0);

      if (usernames.length < 2) {
        showError('Please enter at least 2 usernames to compare.');
        return;
      }
      await fetchMutualFollowers(usernames);
    });

    clearBtn.addEventListener('click', () => {
      resultsSection.style.display = 'none';
      errorSection.style.display   = 'none';
      loadingSection.style.display = 'none';
    });

    async function fetchMutualFollowers(usernames) {
      try {
        resultsSection.style.display = 'none';
        errorSection.style.display   = 'none';
        loadingSection.style.display = 'flex';

        const res  = await fetch('/api/mutual-followers', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ usernames })
        });
        const data = await res.json();

        if (!res.ok) throw new Error(data.error || 'Failed to fetch mutual followers');

        loadingSection.style.display = 'none';
        displayResults(data);
        resultsSection.style.display = 'block';
      } catch (err) {
        loadingSection.style.display = 'none';
        showError(err.message);
      }
    }

    function displayResults(data) {
      document.getElementById('accounts-count').textContent = data.usernames.length;
      document.getElementById('mutual-count').textContent   = data.count;
      followersList.innerHTML = '';

      if (!data.mutualFollowers.length) {
        followersList.innerHTML = '<p class="no-results">No mutual followers found across these accounts.</p>';
        return;
      }

      data.mutualFollowers.forEach((follower, i) => {
        const card = document.createElement('div');
        card.className = 'follower-card';
        card.style.animationDelay = `${i * 35}ms`;
        const fallback = `data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 60 60'><rect fill='%23201c17' width='60' height='60'/><text x='30' y='38' text-anchor='middle' fill='%235a4e3d' font-size='22' font-family='serif'>?</text></svg>`;
        card.innerHTML = `
          <div class="photo-print">
            <img src="${follower.profile_pic_url}" alt="${follower.username}"
                 class="follower-avatar" onerror="this.src='${fallback}'"/>
          </div>
          <div class="follower-meta">
            <p class="follower-username">@${follower.username}</p>
            <p class="follower-name">${follower.full_name || '—'}</p>
          </div>
        `;
        followersList.appendChild(card);
      });
    }

    function showError(msg) {
      loadingSection.style.display = 'none';
      resultsSection.style.display = 'none';
      errorSection.style.display   = 'block';
      document.getElementById('error-message').textContent = msg;
    }
  </script>
</body>
</html>